<resources>
    <!-- Arranque cuando Android está en modo nocturno automático. -->
    <style name="Theme.LasFlores" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#171519</item>
        <item name="android:statusBarColor">#351C27</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#171519</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.LasFlores.Starting" parent="Theme.LasFlores">
        <item name="android:statusBarColor">#171519</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/las_flores_launch</item>
    </style>
</resources>
